&lt;figure&gt;&lt;a data-slb-active="1" data-slb-asset="822542026" data-slb-group="8136" data-slb-internal="0" href="https://www.franzgraf.de/wp-content/uploads/2026/07/DSC01473.jpg"&gt;&lt;img alt="" data-id="8143" decoding="async" loading="lazy" referrerpolicy="no-referrer" src="https://www.franzgraf.de/wp-content/uploads/2026/07/DSC01473.jpg"/&gt;&lt;/a&gt;&lt;/figure&gt;
